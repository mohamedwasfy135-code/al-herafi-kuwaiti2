generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  password                String
  role                    String                   @default("client")
  categoryId              Int?
  phone                   String?
  avatarUrl               String?
  verification_status     String                   @default("pending")
  is_available            Boolean                  @default(true)
  unavailable_until       DateTime?
  latitude                Float?
  longitude               Float?
  rating                  Float                    @default(0)
  total_ratings           Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  subscriptionExpiryDate  DateTime?
  subscriptionStatus      String                   @default("inactive")
  auditLogs               AuditLog[]
  ownedBusiness           Business?
  businessUsers           BusinessUser[]
  clientConversations     Conversation[]           @relation("ClientConversations")
  craftsmanConversations  Conversation[]           @relation("CraftsmanConversations")
  craftsmanDocuments      CraftsmanIDocument?
  interventionRequests    InterventionRequest[]
  sentMessages            Message[]
  notifications           Notification[]
  payoutRequests          PayoutRequest[]
  offers                  PriceOffer[]
  ratingsReceived         Rating[]                 @relation("RatingReceiver")
  ratingsGiven            Rating[]                 @relation("RatingGiver")
  clientRequests          Request[]                @relation("clientRequests")
  craftsmanRequests       Request[]                @relation("assignedCraftsman")
  requestAssignments      RequestAssignment[]
  services                Service[]                @relation("craftsmanServices")
  shareholders            Shareholder[]
  shareholderTransactions ShareholderTransaction[]
  subscriptionPayments    SubscriptionPayment[]
  category                Category?                @relation(fields: [categoryId], references: [id])
}

model Business {
  id                      String                   @id @default(cuid())
  ownerId                 String                   @unique
  categoryId              Int?
  name                    String
  nameEn                  String?
  description             String?
  logoUrl                 String?
  phone                   String?
  email                   String?
  address                 String?
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accounts                Account[]
  auditLogs               AuditLog[]
  bonds                   Bond[]
  category                Category?                @relation(fields: [categoryId], references: [id])
  owner                   User                     @relation(fields: [ownerId], references: [id])
  clients                 BusinessClient[]
  businessSummaries       BusinessSummary?
  transactions            BusinessTransaction[]
  businessUsers           BusinessUser[]
  employees               Employee[]
  expenses                Expense[]
  notificationLogs        NotificationLog[]
  offers                  Offer[]
  priceQuotes             PriceQuote[]
  products                Product[]
  productCategories       ProductCategory[]
  productMovements        ProductMovement[]
  purchaseInvoices        PurchaseInvoice[]
  purchaseReturns         PurchaseReturn[]
  rents                   Rent[]
  salaries                Salary[]
  salesInvoices           SalesInvoice[]
  salesReturns            SalesReturn[]
  shareholders            Shareholder[]
  shareholderTransactions ShareholderTransaction[]
  subscriptions           Subscription?
  suppliers               Supplier[]
  warehouses              Warehouse[]
}

model Category {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  nameEn     String?
  icon       String?
  type       String     @default("service")
  createdAt  DateTime   @default(now())
  businesses Business[]
  requests   Request[]
  services   Service[]
  users      User[]
}

model Service {
  id          Int       @id @default(autoincrement())
  craftsmanId String
  categoryId  Int
  title       String
  description String?
  price       Float     @default(0)
  images      String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  requests    Request[]
  category    Category  @relation(fields: [categoryId], references: [id])
  craftsman   User      @relation("craftsmanServices", fields: [craftsmanId], references: [id])
}

model Request {
  id                      Int                  @id @default(autoincrement())
  status                  String               @default("pending")
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  paymentStatus           String               @default("unpaid")
  visitFeePaid            Boolean              @default(false)
  clientId                String
  address                 String?
  agreedPrice             Float?
  assignmentAttempts      Int                  @default(0)
  businessId              String?
  categoryId              Int?
  city                    String?
  craftsmanId             String?
  currentAssignmentId     Int?
  description             String?
  estimatedPrice          Float?
  finalPrice              Float?
  governorate             String?
  images                  String?
  location                String?
  paymentId               String?
  paymentUrl              String?
  productId               Int?
  proposedPrice           Float?
  remainingAmount         Float?
  requiresAdminAssignment Boolean              @default(false)
  serviceId               Int?
  serviceType             String?
  type                    String               @default("service")
  visitFee                Float?
  craftsmanEarnings       Float?
  platformFee             Float?
  conversations           Conversation[]
  payments                PaymentTransaction[]
  priceOffers             PriceOffer[]
  ratings                 Rating[]
  refundRequests          RefundRequest[]
  category                Category?            @relation(fields: [categoryId], references: [id])
  client                  User                 @relation("clientRequests", fields: [clientId], references: [id])
  craftsman               User?                @relation("assignedCraftsman", fields: [craftsmanId], references: [id])
  product                 Product?             @relation(fields: [productId], references: [id])
  service                 Service?             @relation(fields: [serviceId], references: [id])
  assignments             RequestAssignment[]
}

model RequestAssignment {
  id              Int       @id @default(autoincrement())
  requestId       Int
  craftsmanId     String
  status          String    @default("pending")
  expiresAt       DateTime
  respondedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  craftsman       User      @relation(fields: [craftsmanId], references: [id])
  request         Request   @relation(fields: [requestId], references: [id])

  @@index([requestId, status])
  @@index([craftsmanId, expiresAt])
}

model PriceOffer {
  id                Int      @id @default(autoincrement())
  requestId         Int
  craftsmanId       String
  proposedPrice     Float
  description       String?
  estimatedDuration String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  craftsman         User     @relation(fields: [craftsmanId], references: [id])
  request           Request  @relation(fields: [requestId], references: [id])
}

model Rating {
  id         Int      @id @default(autoincrement())
  requestId  Int
  raterId    String
  ratedId    String
  ratingType String
  stars      Int
  comment    String?
  images     String?
  createdAt  DateTime @default(now())
  rated      User     @relation("RatingReceiver", fields: [ratedId], references: [id])
  rater      User     @relation("RatingGiver", fields: [raterId], references: [id])
  request    Request  @relation(fields: [requestId], references: [id])

  @@unique([requestId, raterId])
}

model ProductCategory {
  id         Int               @id @default(autoincrement())
  businessId String
  name       String
  nameEn     String?
  parentId   Int?
  icon       String?
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  products   Product[]
  business   Business          @relation(fields: [businessId], references: [id])
  parent     ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   ProductCategory[] @relation("CategoryHierarchy")
}

model Product {
  id            Int              @id @default(autoincrement())
  businessId    String
  categoryId    Int?
  name          String
  nameEn        String?
  description   String?
  sku           String?
  barcode       String?
  price         Float            @default(0)
  costPrice     Float            @default(0)
  discountPrice Float?
  stockQuantity Int              @default(0)
  unit          String?
  images        String?
  isFeatured    Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  business      Business         @relation(fields: [businessId], references: [id])
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  requests      Request[]
}

model Warehouse {
  id           Int      @id @default(autoincrement())
  businessId   String
  name         String
  nameEn       String?
  code         String?
  address      String?
  managerName  String?
  managerPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id])
}

model Supplier {
  id            Int      @id @default(autoincrement())
  businessId    String
  name          String
  nameEn        String?
  phone         String?
  email         String?
  address       String?
  contactPerson String?
  contactPhone  String?
  balance       Float    @default(0)
  paymentTerms  String?
  taxNumber     String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id])
}

model Employee {
  id         Int       @id @default(autoincrement())
  businessId String
  name       String
  nameEn     String?
  phone      String?
  email      String?
  nationalId String?
  position   String?
  department String?
  salary     Float     @default(0)
  joinDate   DateTime?
  leaveDate  DateTime?
  bankName   String?
  bankIban   String?
  address    String?
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  paidAt     DateTime?
  business   Business  @relation(fields: [businessId], references: [id])
  salaries   Salary[]
}

model Salary {
  id          Int       @id @default(autoincrement())
  businessId  String
  employeeId  Int
  month       Int
  year        Int
  basicSalary Float
  allowances  Float     @default(0)
  deductions  Float     @default(0)
  netSalary   Float
  status      String    @default("pending")
  paidDate    DateTime?
  notes       String?
  accountId   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model Rent {
  id            Int       @id @default(autoincrement())
  businessId    String
  propertyOwner String?
  propertyDesc  String?
  amount        Float
  dueDay        Int       @default(1)
  startDate     DateTime?
  endDate       DateTime?
  accountId     Int?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business  @relation(fields: [businessId], references: [id])
}

model Account {
  id             Int       @id @default(autoincrement())
  businessId     String
  code           String
  name           String
  nameEn         String?
  accountType    String
  parentId       Int?
  currentBalance Float     @default(0)
  openingBalance Float     @default(0)
  isActive       Boolean   @default(true)
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  business       Business  @relation(fields: [businessId], references: [id])
  parent         Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[] @relation("AccountHierarchy")
}

model SalesInvoice {
  id             Int                @id @default(autoincrement())
  businessId     String
  invoiceNumber  String
  clientId       Int?
  clientName     String?
  clientPhone    String?
  subtotal       Float              @default(0)
  discountAmount Float              @default(0)
  taxAmount      Float              @default(0)
  total          Float              @default(0)
  status         String             @default("draft")
  paidAmount     Float              @default(0)
  paymentMethod  String?
  paymentDate    DateTime?
  accountId      Int?
  dueDate        DateTime?
  notes          String?
  issuedAt       DateTime           @default(now())
  createdAt      DateTime           @default(now())
  business       Business           @relation(fields: [businessId], references: [id])
  items          SalesInvoiceItem[]
}

model SalesInvoiceItem {
  id             Int          @id @default(autoincrement())
  invoiceId      Int
  productId      Int?
  description    String?
  quantity       Float        @default(1)
  unitPrice      Float        @default(0)
  discountAmount Float        @default(0)
  total          Float        @default(0)
  invoice        SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PurchaseInvoice {
  id            Int                   @id @default(autoincrement())
  businessId    String
  invoiceNumber String
  supplierId    Int?
  supplierName  String?
  supplierPhone String?
  subtotal      Float                 @default(0)
  taxAmount     Float                 @default(0)
  total         Float                 @default(0)
  status        String                @default("draft")
  paidAmount    Float                 @default(0)
  paymentMethod String?
  paymentDate   DateTime?
  accountId     Int?
  dueDate       DateTime?
  notes         String?
  issuedAt      DateTime              @default(now())
  createdAt     DateTime              @default(now())
  business      Business              @relation(fields: [businessId], references: [id])
  items         PurchaseInvoiceItem[]
}

model PurchaseInvoiceItem {
  id          Int             @id @default(autoincrement())
  invoiceId   Int
  productId   Int?
  description String?
  quantity    Float           @default(1)
  unitPrice   Float           @default(0)
  total       Float           @default(0)
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model SalesReturn {
  id                Int      @id @default(autoincrement())
  businessId        String
  originalInvoiceId Int
  returnNumber      String
  clientName        String?
  total             Float    @default(0)
  reason            String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  business          Business @relation(fields: [businessId], references: [id])
}

model PurchaseReturn {
  id                Int      @id @default(autoincrement())
  businessId        String
  originalInvoiceId Int
  returnNumber      String
  supplierName      String?
  total             Float    @default(0)
  reason            String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  business          Business @relation(fields: [businessId], references: [id])
}

model Bond {
  id            Int      @id @default(autoincrement())
  businessId    String
  bondNumber    String
  bondType      String
  amount        Float
  accountId     Int?
  partyName     String?
  partyType     String?
  description   String?
  referenceType String?
  referenceId   Int?
  paymentMethod String?
  issuedDate    DateTime @default(now())
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  businessId  String
  category    String
  amount      Float
  description String?
  expenseDate DateTime @default(now())
  receiptUrl  String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id])
}

model Shareholder {
  id           Int                      @id @default(autoincrement())
  businessId   String
  userId       String?
  name         String
  phone        String?
  email        String?
  shareType    String                   @default("share")
  shareCount   Int                      @default(1)
  shareValue   Float                    @default(0)
  totalValue   Float                    @default(0)
  percentage   Float                    @default(0)
  joinDate     DateTime                 @default(now())
  exitDate     DateTime?
  isActive     Boolean                  @default(true)
  notes        String?
  createdAt    DateTime                 @default(now())
  business     Business                 @relation(fields: [businessId], references: [id])
  user         User?                    @relation(fields: [userId], references: [id])
  transactions ShareholderTransaction[]
}

model ShareholderTransaction {
  id              Int         @id @default(autoincrement())
  businessId      String
  shareholderId   Int
  userId          String?
  transactionType String
  amount          Float
  shareCount      Int         @default(0)
  description     String?
  transactionDate DateTime    @default(now())
  accountId       Int?
  createdAt       DateTime    @default(now())
  business        Business    @relation(fields: [businessId], references: [id])
  shareholder     Shareholder @relation(fields: [shareholderId], references: [id])
  user            User?       @relation(fields: [userId], references: [id])
}

model BusinessUser {
  id          String   @id @default(cuid())
  businessId  String
  userId      String?
  name        String
  phone       String?
  email       String?
  password    String
  role        String   @default("seller")
  permissions Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
}

model BusinessSummary {
  id               String   @id @default(cuid())
  businessId       String   @unique
  totalIncome      Float    @default(0)
  totalExpenses    Float    @default(0)
  totalPurchases   Float    @default(0)
  totalCommission  Float    @default(0)
  netProfit        Float    @default(0)
  transactionCount Int      @default(0)
  monthlyData      Json?
  lastUpdated      DateTime @default(now())
  business         Business @relation(fields: [businessId], references: [id])
}

model Offer {
  id                 Int       @id @default(autoincrement())
  businessId         String
  title              String
  description        String?
  discountPercentage Float?
  originalPrice      Float?
  offerPrice         Float?
  imageUrl           String?
  productId          Int?
  isActive           Boolean   @default(true)
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  business           Business  @relation(fields: [businessId], references: [id])
}

model ProductMovement {
  id           Int      @id @default(autoincrement())
  productId    Int
  businessId   String
  warehouseId  Int?
  movementType String
  quantity     Int
  notes        String?
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id])
}

model PriceQuote {
  id                   Int              @id @default(autoincrement())
  businessId           String
  quoteNumber          String
  clientId             Int?
  clientName           String?
  clientPhone          String?
  subtotal             Float            @default(0)
  discountAmount       Float            @default(0)
  taxAmount            Float            @default(0)
  total                Float            @default(0)
  status               String           @default("draft")
  validUntil           DateTime?
  notes                String?
  convertedToInvoiceId Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  business             Business         @relation(fields: [businessId], references: [id])
  items                PriceQuoteItem[]
}

model PriceQuoteItem {
  id             Int        @id @default(autoincrement())
  quoteId        Int
  productId      Int?
  description    String?
  quantity       Float      @default(1)
  unitPrice      Float      @default(0)
  discountAmount Float      @default(0)
  total          Float      @default(0)
  quote          PriceQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id         Int       @id @default(autoincrement())
  businessId String
  type       String
  channel    String
  recipient  String
  title      String
  message    String?
  status     String    @default("pending")
  paymentId  String
  invoiceId  String?
  paymentUrl String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  paidAt     DateTime?
  business   Business  @relation(fields: [businessId], references: [id])
}

model Subscription {
  id         Int       @id @default(autoincrement())
  businessId String    @unique
  plan       String    @default("free")
  startDate  DateTime  @default(now())
  endDate    DateTime?
  autoRenew  Boolean   @default(false)
  status     String    @default("active")
  paymentId  String
  paymentUrl String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  business   Business  @relation(fields: [businessId], references: [id])
}

model BusinessClient {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
}

model BusinessTransaction {
  id              Int      @id @default(autoincrement())
  businessId      String
  type            String
  amount          Float
  description     String?
  category        String?
  referenceType   String?
  referenceId     Int?
  debitAccountId  Int?
  creditAccountId Int?
  transactionDate DateTime @default(now())
  tags            String?
  createdAt       DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  businessId String
  userId     String?
  action     String
  entity     String
  entityId   Int?
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model CraftsmanIDocument {
  id                     Int       @id @default(autoincrement())
  craftsmanId            String    @unique
  civilIdUrl             String?
  bankAccountPhotoUrl    String?
  bankName               String?
  bankIban               String?
  status                 String    @default("pending")
  reviewedBy             String?
  reviewedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  subscriptionExpiryDate DateTime?
  subscriptionStatus     String    @default("inactive")
  craftsman              User      @relation(fields: [craftsmanId], references: [id])
}

model PayoutRequest {
  id          Int      @id @default(autoincrement())
  craftsmanId String
  amount      Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  craftsman   User     @relation(fields: [craftsmanId], references: [id])
}

model InterventionRequest {
  id                 Int      @id @default(autoincrement())
  requestId          Int
  clientId           String
  serviceType        String?
  interventionReason String
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  client             User     @relation(fields: [clientId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model RefundRequest {
  id         Int       @id @default(autoincrement())
  requestId  Int
  amount     Float
  reason     String?
  adminNotes String?
  status     String    @default("pending")
  paymentId  String
  paymentUrl String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  paidAt     DateTime?
  request    Request   @relation(fields: [requestId], references: [id])
}

model PaymentTransaction {
  id         Int       @id @default(autoincrement())
  paymentId  String
  invoiceId  String?
  requestId  Int
  type       String
  amount     Float
  status     String
  paymentUrl String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  paidAt     DateTime?
  request    Request   @relation(fields: [requestId], references: [id])
}

model SubscriptionPayment {
  id        Int      @id @default(autoincrement())
  userId    String
  amount    Float
  status    String   @default("pending")
  paymentId String?
  invoiceId String?
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AppSettings {
  key   String @id
  value String
}

model Conversation {
  id            String    @id @default(cuid())
  requestId     Int?
  clientId      String
  craftsmanId   String
  lastMessage   String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        User      @relation("ClientConversations", fields: [clientId], references: [id])
  craftsman     User      @relation("CraftsmanConversations", fields: [craftsmanId], references: [id])
  request       Request?  @relation(fields: [requestId], references: [id])
  messages      Message[]

  @@unique([clientId, craftsmanId, requestId])
  @@index([clientId])
  @@index([craftsmanId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}
