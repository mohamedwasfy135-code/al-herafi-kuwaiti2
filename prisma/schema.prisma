// ─── Shares & Partnership System ─────────────────────────────────

model Shareholder {
  id            Int      @id @default(autoincrement())
  businessId    String   @map("business_id")
  name          String
  phone         String?
  email         String?
  shareType     String   @default("share") @map("share_type") // share (حصة) أو partnership (شراكة)
  shareCount    Int      @default(1) @map("share_count") // عدد الحصص
  shareValue    Float    @default(0) @map("share_value") // قيمة الحصة الواحدة
  totalValue    Float    @default(0) @map("total_value") // إجمالي قيمة الحصص
  percentage    Float    @default(0) // النسبة المئوية من رأس المال
  joinDate      DateTime? @map("join_date")
  exitDate      DateTime? @map("exit_date")
  isActive      Boolean  @default(true) @map("is_active")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business     Business          @relation(fields: [businessId], references: [id])
  transactions ShareholderTransaction[]

  @@map("shareholders")
}

model ShareholderTransaction {
  id              Int      @id @default(autoincrement())
  businessId      String   @map("business_id")
  shareholderId   Int      @map("shareholder_id")
  transactionType String   @map("transaction_type") // contribution (مساهمة), withdrawal (سحب), profit_distribution (توزيع أرباح), capital_increase (زيادة رأس المال), capital_decrease (تخفيض رأس المال)
  amount          Float
  shareCount      Int      @default(0) @map("share_count") // عدد الحصص المتأثرة
  description     String?
  transactionDate DateTime @map("transaction_date")
  accountId       Int?     @map("account_id") // الحساب المحاسبي المرتبط
  referenceType   String?  @map("reference_type")
  referenceId     Int?     @map("reference_id")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  business    Business    @relation(fields: [businessId], references: [id])
  shareholder Shareholder @relation(fields: [shareholderId], references: [id])
  account     Account?    @relation(fields: [accountId], references: [id])

  @@map("shareholder_transactions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  businessId  String   @map("business_id")
  userId      String?  @map("user_id")
  action      String   // CREATE, UPDATE, DELETE, PAY, MERGE, EXPORT, IMPORT
  entity      String   // Product, Invoice, Bond, etc.
  entityId    Int?     @map("entity_id")
  changes     Json?    // { before: {}, after: {} }
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model NotificationLog {
  id          Int       @id @default(autoincrement())
  businessId  String    @map("business_id")
  type        String    // daily_report, weekly_report, monthly_report, ai_analysis, alert
  channel     String    @default("whatsapp") // whatsapp, email, in_app
  recipient   String    // phone number or email
  title       String
  message     String?
  status      String    @default("pending") // pending, sent, failed
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("notification_logs")
}

// ─── Price Quotes System ──────────────────────────────────────

model PriceQuote {
  id                  Int       @id @default(autoincrement())
  businessId          String    @map("business_id")
  quoteNumber         String    @map("quote_number")
  clientId            Int?      @map("client_id")
  clientName          String?   @map("client_name")
  clientPhone         String?   @map("client_phone")
  subtotal            Float     @default(0)
  discountAmount      Float     @default(0) @map("discount_amount")
  taxAmount           Float     @default(0) @map("tax_amount")
  total               Float     @default(0)
  status              String    @default("draft") // draft, sent, accepted, declined, converted
  validUntil          DateTime? @map("valid_until")
  notes               String?
  convertedToInvoiceId Int?     @map("converted_to_invoice_id")
  issuedAt            DateTime? @map("issued_at")
  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  business Business           @relation(fields: [businessId], references: [id])
  items    PriceQuoteItem[]
  convertedToInvoice SalesInvoice? @relation(fields: [convertedToInvoiceId], references: [id])

  @@map("price_quotes")
}

model PriceQuoteItem {
  id             Int      @id @default(autoincrement())
  quoteId        Int      @map("quote_id")
  productId      Int?     @map("product_id")
  description    String?
  quantity       Float    @default(1)
  unitPrice      Float    @default(0) @map("unit_price")
  discountAmount Float    @default(0) @map("discount_amount")
  total          Float    @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  quote   PriceQuote @relation(fields: [quoteId], references: [id])
  product Product?   @relation(fields: [productId], references: [id])

  @@map("price_quote_items")
}
