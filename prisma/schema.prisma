generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  role                String    @default("client")
  categoryId          Int?
  category            Category? @relation(fields: [categoryId], references: [id])
  phone               String?
  avatarUrl           String?
  verification_status String    @default("pending")
  is_available        Boolean   @default(true)
  unavailable_until   DateTime?
  latitude            Float?
  longitude           Float?
  rating              Float     @default(0)
  total_ratings       Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ownedBusiness           Business?
  services                Service[]                @relation("craftsmanServices")
  clientRequests          Request[]                @relation("clientRequests")
  craftsmanRequests       Request[]                @relation("assignedCraftsman")
  offers                  PriceOffer[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  businessUsers           BusinessUser[]
  shareholders            Shareholder[]
  shareholderTransactions ShareholderTransaction[]
  craftsmanDocuments      CraftsmanIDocument[]
  payoutRequests          PayoutRequest[]
  interventionRequests    InterventionRequest[]
  ratingsGiven            Rating[]                 @relation("RatingGiver")
  ratingsReceived         Rating[]                 @relation("RatingReceiver")
  requestAssignments      RequestAssignment[]
}

model Business {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  categoryId  Int?
  name        String
  nameEn      String?
  description String?
  logoUrl     String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner                   User                     @relation(fields: [ownerId], references: [id])
  category                Category?                @relation(fields: [categoryId], references: [id])
  productCategories       ProductCategory[]
  products                Product[]
  warehouses              Warehouse[]
  suppliers               Supplier[]
  employees               Employee[]
  salaries                Salary[]
  rents                   Rent[]
  accounts                Account[]
  salesInvoices           SalesInvoice[]
  purchaseInvoices        PurchaseInvoice[]
  salesReturns            SalesReturn[]
  purchaseReturns         PurchaseReturn[]
  bonds                   Bond[]
  expenses                Expense[]
  shareholders            Shareholder[]
  shareholderTransactions ShareholderTransaction[]
  businessUsers           BusinessUser[]
  businessSummaries       BusinessSummary[]
  offers                  Offer[]
  productMovements        ProductMovement[]
  priceQuotes             PriceQuote[]
  notificationLogs        NotificationLog[]
  subscriptions           Subscription[]
  clients                 BusinessClient[]
  transactions            BusinessTransaction[]
  auditLogs               AuditLog[]
}

model Category {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  nameEn     String?
  icon       String?
  type       String     @default("service") // ✅ تم الإضافة: service أو business
  createdAt  DateTime   @default(now())
  services   Service[]
  users      User[]
  businesses Business[] // ✅ تم الإضافة
  requests   Request[]
}

model Service {
  id          Int      @id @default(autoincrement())
  craftsmanId String
  categoryId  Int
  title       String
  description String?
  price       Float    @default(0)
  images      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  craftsman User      @relation("craftsmanServices", fields: [craftsmanId], references: [id])
  category  Category  @relation(fields: [categoryId], references: [id])
  requests  Request[]
}

model Request {
  id                      Int       @id @default(autoincrement())
  type                    String    @default("service")
  clientId                String
  craftsmanId             String?
  businessId              String?
  serviceId               Int?
  productId               Int?
  categoryId              Int?
  category                Category? @relation(fields: [categoryId], references: [id])
  serviceType             String?
  description             String?
  images                  String?
  governorate             String?
  city                    String?
  address                 String?
  location                String?
  estimatedPrice          Float?
  agreedPrice             Float?
  finalPrice              Float?
  assignmentAttempts      Int       @default(0)
  currentAssignmentId     Int?
  requiresAdminAssignment Boolean   @default(false)
  status                  String    @default("pending")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  client         User                 @relation("clientRequests", fields: [clientId], references: [id])
  craftsman      User?                @relation("assignedCraftsman", fields: [craftsmanId], references: [id])
  service        Service?             @relation(fields: [serviceId], references: [id])
  product        Product?             @relation(fields: [productId], references: [id])
  priceOffers    PriceOffer[]
  assignments    RequestAssignment[]
  ratings        Rating[]
  refundRequests RefundRequest[]
  visitFee       Float?
  visitFeePaid   Boolean              @default(false)
  paymentUrl     String?
  paymentId      String?
  paymentStatus  String               @default("unpaid")
  payments       PaymentTransaction[]
  remainingAmount   Float?
  proposedPrice     Float?
}

model RequestAssignment {
  id              Int       @id @default(autoincrement())
  requestId       Int
  craftsmanId     String
  status          String    @default("pending")
  expiresAt       DateTime
  respondedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  request   Request @relation(fields: [requestId], references: [id])
  craftsman User    @relation(fields: [craftsmanId], references: [id])

  @@index([requestId, status])
  @@index([craftsmanId, expiresAt])
}

model PriceOffer {
  id                Int      @id @default(autoincrement())
  requestId         Int
  craftsmanId       String
  proposedPrice     Float
  description       String?
  estimatedDuration String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  request   Request @relation(fields: [requestId], references: [id])
  craftsman User    @relation(fields: [craftsmanId], references: [id])
}

model Rating {
  id         Int      @id @default(autoincrement())
  requestId  Int
  raterId    String
  ratedId    String
  ratingType String
  stars      Int
  comment    String?
  images     String?
  createdAt  DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id])
  rater   User    @relation("RatingGiver", fields: [raterId], references: [id])
  rated   User    @relation("RatingReceiver", fields: [ratedId], references: [id])

  @@unique([requestId, raterId])
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  businessId String
  name       String
  nameEn     String?
  parentId   Int?
  icon       String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id])
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]
}

model Product {
  id            Int      @id @default(autoincrement())
  businessId    String
  categoryId    Int?
  name          String
  nameEn        String?
  description   String?
  sku           String?
  barcode       String?
  price         Float    @default(0)
  costPrice     Float    @default(0)
  discountPrice Float?
  stockQuantity Int      @default(0)
  unit          String?
  images        String?
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business         @relation(fields: [businessId], references: [id])
  category ProductCategory? @relation(fields: [categoryId], references: [id])
  requests Request[]
}

model Warehouse {
  id           Int      @id @default(autoincrement())
  businessId   String
  name         String
  nameEn       String?
  code         String?
  address      String?
  managerName  String?
  managerPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model Supplier {
  id            Int      @id @default(autoincrement())
  businessId    String
  name          String
  nameEn        String?
  phone         String?
  email         String?
  address       String?
  contactPerson String?
  contactPhone  String?
  balance       Float    @default(0)
  paymentTerms  String?
  taxNumber     String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model Employee {
  id         Int       @id @default(autoincrement())
  businessId String
  name       String
  nameEn     String?
  phone      String?
  email      String?
  nationalId String?
  position   String?
  department String?
  salary     Float     @default(0)
  joinDate   DateTime?
  leaveDate  DateTime?
  bankName   String?
  bankIban   String?
  address    String?
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  salaries Salary[]
}

model Salary {
  id          Int       @id @default(autoincrement())
  businessId  String
  employeeId  Int
  month       Int
  year        Int
  basicSalary Float
  allowances  Float     @default(0)
  deductions  Float     @default(0)
  netSalary   Float
  status      String    @default("pending")
  paidDate    DateTime?
  notes       String?
  accountId   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

model Rent {
  id            Int       @id @default(autoincrement())
  businessId    String
  propertyOwner String?
  propertyDesc  String?
  amount        Float
  dueDay        Int       @default(1)
  startDate     DateTime?
  endDate       DateTime?
  accountId     Int?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model Account {
  id             Int      @id @default(autoincrement())
  businessId     String
  code           String
  name           String
  nameEn         String?
  accountType    String
  parentId       Int?
  currentBalance Float    @default(0)
  openingBalance Float    @default(0)
  isActive       Boolean  @default(true)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")
}

model SalesInvoice {
  id             Int       @id @default(autoincrement())
  businessId     String
  invoiceNumber  String
  clientId       Int?
  clientName     String?
  clientPhone    String?
  subtotal       Float     @default(0)
  discountAmount Float     @default(0)
  taxAmount      Float     @default(0)
  total          Float     @default(0)
  status         String    @default("draft")
  paidAmount     Float     @default(0)
  paymentMethod  String?
  paymentDate    DateTime?
  accountId      Int?
  dueDate        DateTime?
  notes          String?
  issuedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())

  business Business           @relation(fields: [businessId], references: [id])
  items    SalesInvoiceItem[]
}

model SalesInvoiceItem {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  productId      Int?
  description    String?
  quantity       Float   @default(1)
  unitPrice      Float   @default(0)
  discountAmount Float   @default(0)
  total          Float   @default(0)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PurchaseInvoice {
  id            Int       @id @default(autoincrement())
  businessId    String
  invoiceNumber String
  supplierId    Int?
  supplierName  String?
  supplierPhone String?
  subtotal      Float     @default(0)
  taxAmount     Float     @default(0)
  total         Float     @default(0)
  status        String    @default("draft")
  paidAmount    Float     @default(0)
  paymentMethod String?
  paymentDate   DateTime?
  accountId     Int?
  dueDate       DateTime?
  notes         String?
  issuedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())

  business Business              @relation(fields: [businessId], references: [id])
  items    PurchaseInvoiceItem[]
}

model PurchaseInvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  productId   Int?
  description String?
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  total       Float   @default(0)

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model SalesReturn {
  id                Int      @id @default(autoincrement())
  businessId        String
  originalInvoiceId Int
  returnNumber      String
  clientName        String?
  total             Float    @default(0)
  reason            String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model PurchaseReturn {
  id                Int      @id @default(autoincrement())
  businessId        String
  originalInvoiceId Int
  returnNumber      String
  supplierName      String?
  total             Float    @default(0)
  reason            String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model Bond {
  id            Int      @id @default(autoincrement())
  businessId    String
  bondNumber    String
  bondType      String
  amount        Float
  accountId     Int?
  partyName     String?
  partyType     String?
  description   String?
  referenceType String?
  referenceId   Int?
  paymentMethod String?
  issuedDate    DateTime @default(now())
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  businessId  String
  category    String
  amount      Float
  description String?
  expenseDate DateTime @default(now())
  receiptUrl  String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model Shareholder {
  id         Int       @id @default(autoincrement())
  businessId String
  userId     String?
  name       String
  phone      String?
  email      String?
  shareType  String    @default("share")
  shareCount Int       @default(1)
  shareValue Float     @default(0)
  totalValue Float     @default(0)
  percentage Float     @default(0)
  joinDate   DateTime  @default(now())
  exitDate   DateTime?
  isActive   Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())

  business     Business                 @relation(fields: [businessId], references: [id])
  user         User?                    @relation(fields: [userId], references: [id])
  transactions ShareholderTransaction[]
}

model ShareholderTransaction {
  id              Int      @id @default(autoincrement())
  businessId      String
  shareholderId   Int
  userId          String?
  transactionType String
  amount          Float
  shareCount      Int      @default(0)
  description     String?
  transactionDate DateTime @default(now())
  accountId       Int?
  createdAt       DateTime @default(now())

  business    Business    @relation(fields: [businessId], references: [id])
  shareholder Shareholder @relation(fields: [shareholderId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])
}

model BusinessUser {
  id          String   @id @default(cuid())
  businessId  String
  userId      String?
  name        String
  phone       String?
  email       String?
  password    String
  role        String   @default("seller")
  permissions Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
}

model BusinessSummary {
  id               String   @id @default(cuid())
  businessId       String   @unique
  totalIncome      Float    @default(0)
  totalExpenses    Float    @default(0)
  totalPurchases   Float    @default(0)
  totalCommission  Float    @default(0)
  netProfit        Float    @default(0)
  transactionCount Int      @default(0)
  monthlyData      Json?
  lastUpdated      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model Offer {
  id                 Int       @id @default(autoincrement())
  businessId         String
  title              String
  description        String?
  discountPercentage Float?
  originalPrice      Float?
  offerPrice         Float?
  imageUrl           String?
  productId          Int?
  isActive           Boolean   @default(true)
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model ProductMovement {
  id           Int      @id @default(autoincrement())
  productId    Int
  businessId   String
  warehouseId  Int?
  movementType String
  quantity     Int
  notes        String?
  createdAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model PriceQuote {
  id                   Int       @id @default(autoincrement())
  businessId           String
  quoteNumber          String
  clientId             Int?
  clientName           String?
  clientPhone          String?
  subtotal             Float     @default(0)
  discountAmount       Float     @default(0)
  taxAmount            Float     @default(0)
  total                Float     @default(0)
  status               String    @default("draft")
  validUntil           DateTime?
  notes                String?
  convertedToInvoiceId Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  business Business         @relation(fields: [businessId], references: [id])
  items    PriceQuoteItem[]
}

model PriceQuoteItem {
  id             Int     @id @default(autoincrement())
  quoteId        Int
  productId      Int?
  description    String?
  quantity       Float   @default(1)
  unitPrice      Float   @default(0)
  discountAmount Float   @default(0)
  total          Float   @default(0)

  quote PriceQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id         Int       @id @default(autoincrement())
  businessId String
  type       String
  channel    String
  recipient  String
  title      String
  message    String?
  status     String    @default("pending")
  paymentId  String
  invoiceId  String?
  paymentUrl String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  business Business @relation(fields: [businessId], references: [id])
}

model Subscription {
  id         Int       @id @default(autoincrement())
  businessId String    @unique
  plan       String    @default("free")
  startDate  DateTime  @default(now())
  endDate    DateTime?
  autoRenew  Boolean   @default(false)
  status     String    @default("active")
  paymentId  String
  paymentUrl String?
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model BusinessClient {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model BusinessTransaction {
  id              Int      @id @default(autoincrement())
  businessId      String
  type            String
  amount          Float
  description     String?
  category        String?
  referenceType   String?
  referenceId     Int?
  debitAccountId  Int?
  creditAccountId Int?
  transactionDate DateTime @default(now())
  tags            String?
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  businessId String
  userId     String?
  action     String
  entity     String
  entityId   Int?
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
}

model CraftsmanIDocument {
  id                  Int       @id @default(autoincrement())
  craftsmanId         String
  civilIdUrl          String?
  bankAccountPhotoUrl String?
  bankName            String?
  bankIban            String?
  status              String    @default("pending")
  reviewedBy          String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  craftsman User @relation(fields: [craftsmanId], references: [id])

  @@unique([craftsmanId])
}

model PayoutRequest {
  id          Int      @id @default(autoincrement())
  craftsmanId String
  amount      Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  craftsman User @relation(fields: [craftsmanId], references: [id])
}

model InterventionRequest {
  id                 Int      @id @default(autoincrement())
  requestId          Int
  clientId           String
  serviceType        String?
  interventionReason String
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model RefundRequest {
  id         Int      @id @default(autoincrement())
  requestId  Int
  amount     Float
  reason     String?
  adminNotes String?
  status     String   @default("pending") // pending, approved, rejected
  paymentId  String
  paymentUrl String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime @updatedAt
  request Request @relation(fields: [requestId], references: [id])
}

model PaymentTransaction {
  id         Int       @id @default(autoincrement())
  requestId  Int
  amount     Float
  type       String
  status     String
  paymentId  String
  invoiceId  String?
  paymentUrl String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  request    Request   @relation(fields: [requestId], references: [id])
}
